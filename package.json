{
  "name": "band-monorepo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:client",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:tauri": "npm-run-all -p dev:server tauri:dev",
    "tauri:dev": "cd client && npm run tauri:dev",
    "dev:tauri:asio": "npm-run-all -p dev:server tauri:dev:asio",
    "tauri:dev:asio": "cd client && npm run tauri:dev:asio",
    "tauri:build:asio": "cd client && npm run tauri:build:asio",
    "install:all": "npm --prefix server i && npm --prefix client i",
    "smoke:prod": "node scripts/smoke-prod.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
