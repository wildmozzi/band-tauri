{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Band",
  "version": "0.1.0",
  "identifier": "com.band.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "https://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Band - Real-time Music Collaboration",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval' https://*.tosspayments.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.supabase.co https://band-server.fly.dev https://*.tosspayments.com",
        "media-src": "'self' data: blob: mediastream: https://*.supabase.co https://band-server.fly.dev",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://band-server.fly.dev wss://band-server.fly.dev https://*.tosspayments.com",
        "frame-src": "https://*.tosspayments.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self' https://*.tosspayments.com"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'wasm-unsafe-eval' https://*.tosspayments.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.supabase.co https://band-server.fly.dev https://*.tosspayments.com http://localhost:* https://localhost:*",
        "media-src": "'self' data: blob: mediastream: https://*.supabase.co https://band-server.fly.dev http://localhost:* https://localhost:*",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://band-server.fly.dev wss://band-server.fly.dev https://*.tosspayments.com http://localhost:* https://localhost:* ws://localhost:* wss://localhost:* http://127.0.0.1:* ws://127.0.0.1:*",
        "frame-src": "https://*.tosspayments.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self' https://*.tosspayments.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
