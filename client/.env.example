VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# 'auto' = 현재 접속한 호스트 자동 감지 (LAN 테스트에 유용)
# 또는 직접 지정: wss://localhost:8080, wss://192.168.0.10:8080
VITE_SIGNALING_URL=auto
VITE_API_URL=auto
# 웹(관람 전용)에서 보여 줄 데스크톱 앱 다운로드 링크. 비우면 "다운로드 준비 중"으로 표시
VITE_DESKTOP_DOWNLOAD_URL=
VITE_TOSS_PAYMENTS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq

# ========== Demucs 음원 분리 설정 ==========
# 개발용: Python Demucs API 직접 호출
VITE_DEMUCS_API_URL=http://localhost:8000

# 배포용: Node.js 백엔드 경유 (HuggingFace/Replicate 프로바이더 사용)
# true로 설정하면 VITE_API_URL의 /api/music/separate-stems 사용
VITE_USE_BACKEND_DEMUCS=false
