# Supabase 연결 설정
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
# ↑ service_role 키: WS 인증(auth.getUser)·rooms.host_id 조회에 사용. 절대 클라이언트에 노출 금지

# CORS 허용 origin (쉼표 구분). Tauri origin은 항상 허용됨
# 미설정 시: NODE_ENV=development 이면 전체 허용, 그 외(운영)는 Tauri origin만 허용(웹 origin 거부)
CORS_ORIGINS=https://localhost:5173,https://your-web-domain.example

# 토스페이먼츠 시크릿 키 (fly secrets로 설정, 커밋 금지)
TOSS_PAYMENTS_SECRET_KEY=your_toss_secret_key

# 로컬 개발이면 development. Docker 이미지는 production으로 고정됨
NODE_ENV=development

# Supabase 없이 로컬 WS 테스트할 때만 1 (NODE_ENV=development 일 때만 동작).
# 켜지면 클라이언트가 보낸 userId/isHost를 그대로 신뢰하므로 절대 운영에서 쓰지 말 것
# ALLOW_INSECURE_WS=1

# 업로드 디렉터리 (기본: server/uploads)
# UPLOAD_DIR=

# UDP 릴레이 토큰 발급 (선택, docs/overhaul/relay-design.md). 둘 다 있어야 켜짐
# RELAY_SECRET은 릴레이 서버와 같은 값(32바이트 이상), fly secrets로 설정. 커밋 금지
# RELAY_SECRET=your_relay_secret
# RELAY_ADDR=relay.example.com:5000
# RELAY_TOKEN_TTL_SEC=600

# 서버 포트 (기본값: 8080)
PORT=8080

# ========== Demucs 음원 분리 설정 ==========
# 프로바이더 선택: local | huggingface | replicate
# - local: 로컬 Python 실행 (개발용, GPU 있으면 빠름)
# - huggingface: Hugging Face Spaces (무료)
# - replicate: Replicate API (유료, 프로덕션용)
DEMUCS_PROVIDER=local

# Python 실행 경로 (Windows에서 앱스토어 stub 충돌 방지용)
# `where python` (Windows) 또는 `which python3` (Mac·Linux) 로 경로 확인
# 예) Windows: C:\Python312\python.exe
# 예) Mac·Linux: python3
PYTHON_PATH=C:\Python312\python.exe

# Hugging Face Spaces URL (DEMUCS_PROVIDER=huggingface 일 때)
# HF_SPACE_URL=https://facebook-demucs.hf.space

# Replicate API (DEMUCS_PROVIDER=replicate 일 때 필요)
# REPLICATE_API_TOKEN=your_replicate_token

# ========== 악보 읽기 (PDF → MusicXML, Audiveris OMR) ==========
# Audiveris 실행 파일 경로 (기본값: C:/Program Files/Audiveris/bin/Audiveris.bat)
# AUDIVERIS_BAT=C:/Program Files/Audiveris/bin/Audiveris.bat
# Java 경로 (미설정 시 PATH의 java 사용)
# JAVA_HOME=C:\Program Files\Java\jdk-21

# ========== 결제 (토스페이먼츠) ==========
# 자세한 설정: docs/PAYMENT_SETUP.md
# TOSS_PAYMENTS_SECRET_KEY=test_sk_xxx

# ========== MP3 → MIDI 변환 (AMT API, 선택) ==========
# AMT_API_URL=https://api.example-amt.com
# AMT_API_KEY=your_amt_api_key
