# 루트 유지보수 스크립트용 환경변수 (run-migrations.js, setup-rls.js, check-db.js)
# 이 파일을 .env로 복사하지 말고 실행 시 환경변수로 넘기는 것을 권장한다.
#   예) DATABASE_URL=... node run-migrations.js

# Supabase Postgres 접속 문자열 (Dashboard > Project Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@your-pooler-host:6543/postgres

# Supabase 프로젝트 URL / anon key (check-db.js)
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
